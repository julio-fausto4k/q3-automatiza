# ===== Variáveis de Exemplo =====

# Ex.: [{"username":"admin","pw_hash":"COLOQUE_AQUI_UM_HASH_BCRYPT"}]
Q3_USERS_JSON=[]

OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

Q3_SHOW_EXEC=True
Q3_PRICE_DEBUG=1
Q3_POLL_TRIES=15
Q3_POLL_DELAY=0.6

Q3_HTTP_RETRY_TOTAL=1
Q3_HTTP_BACKOFF=0.1
Q3_HTTP_RESPECT_RETRY_AFTER=false

Q3_SELLABLE_PAGE_SIZE=200
Q3_SELLABLE_MAX_PAGES=6

PUBLIC_APP_URL=http://localhost:8501

SMTP_HOST=smtp.seu-dominio.com
SMTP_PORT=587
SMTP_USER=usuario@seu-dominio.com
SMTP_PASS=sua_senha_aqui
SMTP_FROM="Q3 Automatiza <no-reply@seu-dominio.com>"